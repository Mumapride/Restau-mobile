# Environment configuration for the RESTAU admin web application.
# Copy this file to .env and fill in the values (do not commit .env).

# Base URL of the RESTAU backend API.
# The backend (Express) listens on port 5000 and mounts all routes under /api.
# Example: http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: port for the Vite dev server.
# VITE_DEV_PORT=5174
